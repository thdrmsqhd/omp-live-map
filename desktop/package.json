{
  "name": "omp-live-map-v3-desktop",
  "version": "8.5.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:windows": "node prepare-ant.cjs && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.8.12",
    "electron-builder": "26.0.12",
    "monaco-editor": "0.52.2"
  },
  "description": "OMP Live Map desktop",
  "author": "OMP Live Map",
  "build": {
    "appId": "dev.omplivemap.v3",
    "productName": "OMP Live Map V3",
    "files": [
      "main.cjs",
      "preload.cjs",
      "credentials.cjs",
      "icons/omp-live-map.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "runtime/server"
      },
      {
        "from": "../server.js",
        "to": "runtime/server.js"
      },
      {
        "from": "../ui",
        "to": "runtime/ui"
      },
      {
        "from": "node_modules/monaco-editor/min",
        "to": "runtime/ui/vendor/monaco"
      },
      {
        "from": ".vendor/ant",
        "to": "runtime/vendor/ant"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/omp-live-map.ico",
      "artifactName": "OMP-Live-Map-V3-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    }
  }
}
